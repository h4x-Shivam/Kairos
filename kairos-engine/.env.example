# ==============================================================================
# Kairos Quant Engine — Backend Environment Variables (.env)
# ==============================================================================

ENVIRONMENT=development
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# 1. AngelOne SmartAPI (Primary High-Speed Telemetry Provider)
#    Get these from your AngelOne developer portal: https://smartapi.angelbroking.com
#    Note: If left empty, the engine automatically falls back to Yahoo Finance & NSE Direct.
# ------------------------------------------------------------------------------
ANGELONE_API_KEY=dmsnd4rJ
ANGELONE_CLIENT_CODE=N51690180
ANGELONE_PIN=1973
ANGELONE_TOTP_KEY=N2NZJ64ZWR2TY2PSNUSLZAKK2A

# ------------------------------------------------------------------------------
# 2. Resilient Ingestion & Fallback Flags
# ------------------------------------------------------------------------------
ENABLE_YFINANCE_FALLBACK=true
ENABLE_NSE_SCRAPER_FALLBACK=true

# ------------------------------------------------------------------------------
# 3. In-Memory & Redis Cache TTL Settings (in Seconds)
# ------------------------------------------------------------------------------
CACHE_TTL_QUOTE_SECONDS=15
CACHE_TTL_OHLCV_SECONDS=300
CACHE_TTL_FUNDAMENTALS_SECONDS=86400
CACHE_TTL_FILINGS_SECONDS=1800
HTTP_TIMEOUT_SECONDS=10.0
